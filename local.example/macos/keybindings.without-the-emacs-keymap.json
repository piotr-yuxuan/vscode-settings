// The Emacs keys that VS Code's own commands can give on a Mac where the keymap extension
// (tuttieee.emacs-mcx) may not be installed.
//
// Copy it, as keybindings.json, into the machine-local directory that
// `bin/vscode-settings status` prints. macOS itself already gives C-a, C-e, C-f, C-b, C-n,
// C-p, C-k, C-d and C-h in editors, and the rules of user/keybindings.json that call
// VS Code's own commands keep working. Lost without the extension: the mark (hold Shift
// instead), the kill ring, prefix arguments, rectangles.
// Untested: derived from VS Code's list of commands, never pressed.
[
  // M-x: the Command Palette
  { "key": "alt+x", "command": "workbench.action.showCommands" },
  // C-x C-f: open a file of the project by name
  { "key": "ctrl+x ctrl+f", "command": "workbench.action.quickOpen", "when": "!terminalFocus" },
  // C-x b: switch to another open file
  { "key": "ctrl+x b", "command": "workbench.action.showAllEditorsByMostRecentlyUsed", "when": "!terminalFocus" },
  // C-x k: close the file
  { "key": "ctrl+x k", "command": "workbench.action.closeActiveEditor", "when": "!terminalFocus" },
  // C-x C-s: save
  { "key": "ctrl+x ctrl+s", "command": "workbench.action.files.save", "when": "!terminalFocus" },
  // C-x h: select everything
  { "key": "ctrl+x h", "command": "editor.action.selectAll", "when": "editorTextFocus" },
  // C-x o: go to the next window
  { "key": "ctrl+x o", "command": "workbench.action.focusNextGroup", "when": "!terminalFocus" },
  // C-x 0: close this window
  { "key": "ctrl+x 0", "command": "workbench.action.closeEditorsInGroup", "when": "!terminalFocus" },
  // C-x 2: split below
  { "key": "ctrl+x 2", "command": "workbench.action.splitEditorDown", "when": "!terminalFocus" },
  // C-x 3: split to the right
  { "key": "ctrl+x 3", "command": "workbench.action.splitEditorRight", "when": "!terminalFocus" },
  // C-s: search in the file
  { "key": "ctrl+s", "command": "actions.find", "when": "editorTextFocus" },
  // C-s again: the next match
  { "key": "ctrl+s", "command": "editor.action.nextMatchFindAction", "when": "findInputFocussed" },
  // C-r: the previous match
  { "key": "ctrl+r", "command": "editor.action.previousMatchFindAction", "when": "findInputFocussed" },
  // C-g: leave the search
  { "key": "ctrl+g", "command": "closeFindWidget", "when": "findWidgetVisible" },
  // C-g: drop the selection
  { "key": "ctrl+g", "command": "cancelSelection", "when": "editorTextFocus && editorHasSelection && !findWidgetVisible" },
  // C-g: close the Command Palette or the file prompt
  { "key": "ctrl+g", "command": "workbench.action.closeQuickOpen", "when": "inQuickOpen" },
  // C-w: cut
  { "key": "ctrl+w", "command": "editor.action.clipboardCutAction", "when": "editorTextFocus" },
  // M-w: copy
  { "key": "alt+w", "command": "editor.action.clipboardCopyAction", "when": "editorTextFocus" },
  // C-y: paste
  { "key": "ctrl+y", "command": "editor.action.clipboardPasteAction", "when": "editorTextFocus" },
  // C-/: undo
  { "key": "ctrl+/", "command": "undo", "when": "editorTextFocus" },
  // M-f: forward one word
  { "key": "alt+f", "command": "cursorWordEndRight", "when": "editorTextFocus" },
  // M-b: back one word
  { "key": "alt+b", "command": "cursorWordStartLeft", "when": "editorTextFocus" },
  // M-d: delete the next word
  { "key": "alt+d", "command": "deleteWordRight", "when": "editorTextFocus" },
  // M-<: the top of the file
  { "key": "alt+shift+,", "command": "cursorTop", "when": "editorTextFocus" },
  // M->: the end of the file
  { "key": "alt+shift+.", "command": "cursorBottom", "when": "editorTextFocus" },
  // M-.: go to the definition
  { "key": "alt+.", "command": "editor.action.revealDefinition", "when": "editorTextFocus" },
  // M-,: come back
  { "key": "alt+,", "command": "workbench.action.navigateBack" },
  // M-g g: go to a line
  { "key": "alt+g g", "command": "workbench.action.gotoLine", "when": "editorTextFocus" },
  // M-y is a plain paste: there is no kill ring to pick from
  { "key": "alt+y", "command": "editor.action.clipboardPasteAction", "when": "editorTextFocus" },
  // C-x g: the Source Control view, if edamagit is refused too
  { "key": "ctrl+x g", "command": "workbench.view.scm", "when": "!terminalFocus" }
]
